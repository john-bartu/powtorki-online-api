          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "5.Funkcje organizacji międzynarodowych",
          "type": "text",
          "marks": [
            {
              "type": "bold"
            }
          ]
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "funkcja regulacyjna ",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": "– polega na regulowaniu postępowania państw w stosunkach międzynarodowych przez tworzenie norm i wzorców",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "funkcja operacyjna ",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": "– polega na bezpośrednim świadczeniu przez organizację usług za pomocą własnych decyzji, organów i środków, którymi dysponują",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "funkcja kontrolna ",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": "– polega na kontrolowaniu postępowania państw i ustalaniu, czy jest ono zgodne z przyjętymi zobowiązaniami.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "arbitrażowe i sądowe",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": " -prowadzą działalność rozjemczą",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "zarządzająca- ",
                  "type": "text",
                  "marks": [
                    {
                      "type": "bold"
                    }
                  ]
                },
                {
                  "text": "realizacja zadań statutowych",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
